[Unit]
Description=mabel-world listener - office-01 observation ingest (port 8891)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mabel
Group=mabel
WorkingDirectory=/home/mabel/mabel-world
ExecStart=/usr/bin/python3 /home/mabel/mabel-world/listener.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
